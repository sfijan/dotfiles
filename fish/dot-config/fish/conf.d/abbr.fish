# git
abbr -a -- gs 'git status'
abbr -a -- gd 'git diff'
abbr -a -- ga 'git add'
abbr -a -- gc 'git commit'
abbr -a -- gp 'git push'
abbr -a -- gu 'git pull'
# abbr -a -- gl 'git log --oneline --color --graph'
abbr -a -- gl "git log --all --graph --pretty=\
format:'%C(magenta)%h %C(white) %an  %ar%C(auto)  %D%n%S%n'"
abbr -a -- gb 'git branch'
